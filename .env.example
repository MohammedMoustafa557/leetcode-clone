# Copy to .env and change the values. Never commit your real .env.
POSTGRES_USER=leetcode
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leetcode

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SEED_ON_START=true

# Empty = load Pyodide from the jsDelivr CDN. "/pyodide/" = self-host it.
VITE_PYODIDE_URL=

# Public URL of the site (used in links sent to Notion)
PUBLIC_SITE_URL=http://localhost:8080

# Optional: OpenAI-compatible LLM for richer per-problem guides (leave empty = derived hints only)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Weekly contest schedule (contest #1 = CONTEST_FIRST_DATE; default Fridays 16:00 UTC, 90 minutes)
CONTEST_FIRST_DATE=2026-01-02
CONTEST_START_UTC=16:00
CONTEST_MINUTES=90

# Optional Notion sync of ONE user's first-time solves (off when empty)
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_SYNC_USERNAME=
